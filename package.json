{
  "name": "@dalydb/sdesign",
  "version": "1.3.5",
  "description": "@dalydb/PC端组件库",
  "keywords": [
    "react",
    "antd",
    "ahooks",
    "dumi",
    "father",
    "typescript",
    "antd-style"
  ],
  "license": "MIT",
  "author": "dsh",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sdesign-ai": "./scripts/cli/sdesign-ai.ts"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "files": [
    "dist",
    "ai",
    "scripts/cli"
  ],
  "scripts": {
    "ai:generate": "tsx scripts/gen-llms-txt.ts",
    "build": "father build",
    "build:watch": "father dev",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "doctor": "father doctor",
    "format": "prettier --write .",
    "lint": "npm run lint:es && npm run lint:css",
    "lint:css": "stylelint \"{src,test}/**/*.{css,less}\"",
    "lint:es": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "lint:es-fix": "npm run lint:es -- --fix",
    "prepare": "husky install && dumi setup",
    "prepublishOnly": "father doctor && npm run build && npm run ai:generate",
    "start": "npm run dev",
    "version:major": "npm version major",
    "version:minor": "npm version minor",
    "version:patch": "npm version patch"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "ahooks": "^3.7.4",
    "antd-style": "^3.6.2",
    "axios": "^1.13.4",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^3.3.3",
    "lodash": "^4.17.21",
    "react-error-boundary": "6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@rsbuild/plugin-less": "^1.5.0",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rslib/core": "^0.18.5",
    "@types/lodash": "^4.17.1",
    "@types/node": "^20.8.3",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@typescript-eslint/parser": "^7.11.0",
    "@umijs/lint": "^4.0.0",
    "dumi": "~2.4.21",
    "dumi-theme-antd-style": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "father": "^4.6.11",
    "husky": "^8.0.1",
    "jsdom": "^27.4.0",
    "lint-staged": "^13.0.3",
    "mockdate": "^3.0.5",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router": "^6.16.0",
    "react-router-dom": "^6.23.1",
    "stylelint": "^14.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@ant-design/icons": ">=5.0.0",
    "antd": ">=5.20.6 || <6.0.0",
    "dayjs": "^1.11.0",
    "lucide-react": ">=0.500.0 || <=0.572.0",
    "react": ">=18.0.0 || <19.0.0",
    "react-dom": ">=18.0.0 || <19.0.0",
    "react-router": ">=6.0.0 || <7.0.0"
  },
  "engines": {
    "node": ">=16.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "core-js",
      "core-js-pure",
      "esbuild",
      "less"
    ]
  },
  "authors": []
}
